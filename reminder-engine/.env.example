# 复制本文件为 .env 并按需填写。.env 已被 .gitignore 忽略，请勿提交。
# ---- 邮件 SMTP（网易企业邮）----
EMAIL_ENABLED=true
EMAIL_HOST=smtp.qiye.163.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=你的发件邮箱账号@law.pku.edu.cn
EMAIL_PASS=你的SMTP授权码
EMAIL_FROM=日程助手 <你的发件邮箱账号@law.pku.edu.cn>

# ---- 微信订阅消息（可选）----
WECHAT_SECRET=

# ---- 常驻服务鉴权 Token（可选，留空则不启用鉴权）----
AUTH_TOKEN=

# ---- 运行监控告警（可选）----
# 告警推送地址：企业微信/钉钉/飞书群机器人 Webhook，或自建告警服务地址。
# 留空则告警仅落本地日志（reminder-engine/logs/），不对外推送。
ALERT_WEBHOOK_URL=
