.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-link {
  color: #3b82f6;
  font-size: 26rpx;
}

.section {
  font-size: 30rpx;
  font-weight: 500;
  margin: 8rpx 4rpx 16rpx;
}

.status-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot-ok { background: #16a34a; }
.dot-bad { background: #ef4444; }
.dot-muted { background: #b0b6c0; }

.status-text {
  font-size: 28rpx;
  color: #3f4552;
}

.metric-grid {
  display: flex;
  margin-top: 16rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2329;
}

.metric-label {
  font-size: 22rpx;
  color: #8a919f;
  margin-top: 4rpx;
}

.env-row {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.empty-desc {
  color: #8a919f;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.err-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.err-item:last-child {
  border-bottom: none;
}

.err-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.err-time {
  font-size: 22rpx;
  color: #b0b6c0;
}

.err-msg {
  font-size: 26rpx;
  color: #3f4552;
  word-break: break-all;
}

.err-url {
  font-size: 22rpx;
  margin-top: 4rpx;
  word-break: break-all;
}

.req-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
  gap: 12rpx;
}

.req-row:last-child {
  border-bottom: none;
}

.req-status {
  font-size: 24rpx;
  font-weight: 600;
  min-width: 48rpx;
}

.req-ok { color: #16a34a; }
.req-bad { color: #ef4444; }

.req-method {
  font-size: 22rpx;
  color: #6b7280;
  min-width: 72rpx;
}

.req-url {
  flex: 1;
  font-size: 24rpx;
  color: #3f4552;
}

.req-dur {
  font-size: 22rpx;
  white-space: nowrap;
}
