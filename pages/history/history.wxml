<view class="page">
  <view class="header">
    <view class="title">历史日程</view>
  </view>

  <block wx:if="{{!loggedIn && !loading}}">
    <view class="card empty">
      <view class="empty-title">登录后查看历史日程</view>
      <view class="empty-desc">微信一键登录，回顾你的活动与任务</view>
      <view class="btn-primary login-btn" bindtap="doLogin">微信登录</view>
    </view>
  </block>

  <block wx:if="{{loggedIn}}">
    <!-- 活动历史 -->
    <view class="section sub">活动 · {{histActivity.length}}</view>
    <view wx:if="{{histActivity.length === 0}}" class="card empty">
      <view class="empty-desc">暂无历史活动</view>
    </view>
    <view wx:for="{{histActivity}}" wx:key="id" class="card event dim" data-id="{{item.id}}" bindtap="goDetail">
      <view class="event-name">{{item.name}}</view>
      <view class="event-row muted">{{item.startLabel}}{{item.endLabel ? ' — ' + item.endLabel : ''}}</view>
      <view wx:if="{{item.location}}" class="event-row muted">地点 {{item.location}}</view>
      <view wx:if="{{item.completed}}" class="event-row"><text class="tag tag-done">已完成</text></view>
    </view>

    <!-- 任务历史 -->
    <view class="section sub">任务 · {{histTask.length}}</view>
    <view wx:if="{{histTask.length === 0}}" class="card empty">
      <view class="empty-desc">暂无历史任务</view>
    </view>
    <view wx:for="{{histTask}}" wx:key="id" class="card event dim" data-id="{{item.id}}" bindtap="goDetail">
      <view class="event-name">{{item.name}}</view>
      <view wx:if="{{item.content}}" class="event-row muted">{{item.content}}</view>
      <view wx:if="{{item.ddlLabel}}" class="event-row muted">截止 {{item.ddlLabel}}</view>
      <view class="event-row"><text class="tag tag-done">已完成</text></view>
    </view>

    <!-- 周期任务历史 -->
    <view class="section sub">周期任务 · {{histRecurring.length}}</view>
    <view wx:if="{{histRecurring.length === 0}}" class="card empty">
      <view class="empty-desc">暂无历史周期任务</view>
    </view>
    <view wx:for="{{histRecurring}}" wx:key="id" class="card event dim" data-id="{{item.id}}" bindtap="goDetail">
      <view class="event-name">{{item.name}}</view>
      <view wx:if="{{item.content}}" class="event-row muted">{{item.content}}</view>
      <view wx:if="{{item.reminderTimeLabel}}" class="event-row muted">每天 {{item.reminderTimeLabel}} 提醒</view>
      <view class="event-row">
        <text wx:if="{{item.terminated}}" class="tag tag-danger">已终结</text>
        <text wx:else class="tag tag-done">已完成</text>
      </view>
    </view>
  </block>
</view>
