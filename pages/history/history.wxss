.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.section.sub {
  font-size: 26rpx;
  color: #8a919f;
  font-weight: 500;
  margin: 16rpx 4rpx 12rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.event-row {
  font-size: 26rpx;
  color: #3f4552;
  margin-bottom: 4rpx;
}

.dim {
  opacity: 0.6;
}

.empty {
  text-align: center;
  padding: 32rpx 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  color: #8a919f;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 320rpx;
  margin: 0 auto;
}
