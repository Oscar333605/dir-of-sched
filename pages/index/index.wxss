.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.tabs {
  display: flex;
  background: #eef1f5;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: #3b82f6;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.settings {
  color: #3b82f6;
  font-size: 26rpx;
}

.section {
  font-size: 26rpx;
  color: #8a919f;
  margin: 8rpx 4rpx 16rpx;
}

.hint-tip {
  font-size: 22rpx;
  color: #b0b6c0;
  margin-left: 12rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.event-row {
  font-size: 26rpx;
  color: #3f4552;
  margin-bottom: 4rpx;
}

.tags {
  margin-top: 12rpx;
}

.tag {
  margin-right: 12rpx;
}

.dim {
  opacity: 0.6;
}

.empty {
  text-align: center;
  padding: 64rpx 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  color: #8a919f;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.login-btn {
  width: 320rpx;
  margin: 0 auto;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #3b82f6;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 108rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}
