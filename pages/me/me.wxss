.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.section {
  font-size: 30rpx;
  font-weight: 500;
  margin: 8rpx 4rpx 16rpx;
}

.section.sub {
  font-size: 26rpx;
  color: #8a919f;
  font-weight: 500;
  margin: 16rpx 4rpx 12rpx;
}

.line {
  font-size: 28rpx;
  color: #3f4552;
}

.hint {
  color: #8a919f;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.input {
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.login-btn,
.save-btn {
  margin-top: 16rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.event-row {
  font-size: 26rpx;
  color: #3f4552;
  margin-bottom: 4rpx;
}

.empty {
  text-align: center;
  padding: 32rpx 28rpx;
}

.empty-desc {
  color: #8a919f;
  font-size: 26rpx;
}
